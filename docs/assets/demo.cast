[2.003, "o", "\r\n\u001b[1;36m▶ 7/7  Admission control — a mutable tag is rejected before it is stored\u001b[0m\r\n$ kubectl apply -f config/samples/platform_v1_webapp_invalid.yaml\r\n"]
