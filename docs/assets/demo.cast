[2.004, "o", "\r\n\u001b[1;36m▶ 6/7  Self-healing — delete the Deployment and watch it come back\u001b[0m\r\n\u001b[0;90m$ kubectl delete deployment webapp-sample-deployment\u001b[0m\r\n"]
[0.115, "o", "deployment.apps \"webapp-sample-deployment\" deleted from default namespace\r\n"]
