[0.006, "o", "\r\n\u001b[1;36m▶ 5/7  Create a WebApp — one resource in, a full stack out\u001b[0m\r\n\u001b[0;90m$ kubectl apply -f config/samples/platform_v1_webapp.yaml\u001b[0m\r\n"]
[0.140, "o", "webapp.platform.miportfolio.com/webapp-sample created\r\n"]
[0.003, "o", "\u001b[0;90m$ kubectl wait --for=condition=Available --timeout=180s deployment/webapp-sample-deployment\u001b[0m\r\n"]
[12.504, "o", "deployment.apps/webapp-sample-deployment condition met\r\n"]
